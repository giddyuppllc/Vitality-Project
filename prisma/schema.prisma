  phoneContact       Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  @@map("communication_preferences")
}

// ─── Membership Tiers (Vitality Club) ───────────────────────────────────────

model Membership {
  id                            String         @id @default(cuid())
  userId                        String         @unique
  tier                          MembershipTier @default(NONE)
  // PENDING_PAYMENT (first invoice unpaid) / ACTIVE / PAUSED / CANCELLED
  status                        String         @default("ACTIVE")
  monthlyPriceCents             Int            @default(0)
  startedAt                     DateTime       @default(now())
  // First time an invoice for this membership was actually paid. Distinct
  // from startedAt (signup) so we can show "signed up X, paid Y".
  paymentConfirmedAt            DateTime?
  renewsAt                      DateTime?
  cancelledAt                   DateTime?
  // Free peptide credits earned per billing period (Plus = 1, Premium = 3)
  freePeptideCreditsThisPeriod  Int            @default(0)
  freePeptidesUsedThisPeriod    Int            @default(0)
  // Free BAC + syringes: a single per-cycle allotment (Plus/Premium). Reset to
  // false on each paid cycle; flipped true once auto-added to an order.
  freeSuppliesClaimedThisPeriod Boolean        @default(false)
  // Stripe-style subscription tracking — Chase will go here when ready
  externalSubscriptionId        String?
  paymentProvider               String? // 'chase', 'stripe', etc.
  // Outstanding Zelle invoice Order awaiting admin mark-paid (if any).
  pendingInvoiceOrderId         String?
  // Rate-limit reminder emails to PENDING_PAYMENT signups.
  lastReminderSentAt            DateTime?
  // Rate-limit the OVERDUE notices sent to an ACTIVE member past renewsAt.
  // Deliberately separate from lastReminderSentAt: that one paces the
  // pre-activation signup chase, this one paces the renewal chase, and a
  // membership can legitimately have been through both.
  lastOverdueNoticeAt           DateTime?
  user                          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  @@map("memberships")
}

enum MembershipTier {
  NONE
  CLUB // $25/mo
  PLUS // $150/mo
  PREMIUM // $300/mo
}

// ─── Certificates of Analysis ────────────────────────────────────────────────
// Lab CoAs uploaded by admin. Searchable by peptide name, indexed by lot.
// History per peptide is preserved — every upload is a new row.

model CertificateOfAnalysis {
  id             String    @id @default(cuid())
  productSlug    String? // optional link to a Product
  productName    String // free-text — searchable (e.g. "BPC-157", "Retatrutide 5mg")
  variant        String? // e.g. "5mg", "lyophilized" — optional detail
  lotNumber      String
  documentUrl    String // path to uploaded PDF or external URL
  fileName       String?
  testDate       DateTime?
  expiryDate     DateTime?
  purity         String? // e.g. "99.2%"
  testingLab     String? // e.g. "Janoshik Analytical"
  notes          String?   @db.Text
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime  @default(now())

  @@index([productName])
  @@index([productSlug])
  @@index([lotNumber])
  @@index([createdAt])
  @@map("certificates_of_analysis")
}

// ─── Blog / Research content ─────────────────────────────────────────────────
// DB-driven blog so staff can publish without a code deploy. The public /blog +
// /blog/[slug] pages read PUBLISHED posts here; the 14 legacy static posts in
// src/lib/blog-data.ts are seeded in (prisma/seed-posts.ts) so nothing is lost.
model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String    @db.Text
  content      String    @db.Text // HTML body
  category     String    @default("Research")
  readTime     String? // e.g. "6 min read" — optional, computed from content if blank
  coverImage   String?
  relatedLinks Json      @default("[]") // { href: string; label: string }[]
  authorName   String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("posts")
}

// ─── VIP Clubhouse (vitalityproject.vip) ────────────────────────────────────
// Members' community, classroom, events and tier rewards. Served by this same
// app on the .vip host (src/proxy.ts rewrites into src/app/vip). One database,
// one User table: membership status comes from `Membership`, never duplicated.
// Hand-written SQL twin: prisma/migrations-manual/001_vip_clubhouse.sql.

// Per-member community profile + community-only suspension (independent of
// the paid membership status).
model VipProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  displayName          String?
  bio                  String?   @db.Text
  avatarUrl            String?
  suspendedAt          DateTime?
  suspendedReason      String?
  suspendedById        String?
  // Clubhouse email preferences (per member; every clubhouse email links here).
  emailDigest          Boolean   @default(true) // daily reply/mention digest
  emailEvents          Boolean   @default(true) // 24h + 1h reminders for RSVP'd events
  emailRewards         Boolean   @default(true) // "your monthly reward landed"
  welcomeEmailAt       DateTime? // welcome-to-the-clubhouse sent (once)
  digestSentAt         DateTime? // last digest sent
  onboardedAt          DateTime? // "Start here" checklist dismissed
  // Rewards leaderboards: true = never listed (the member still earns).
  hideFromLeaderboards Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Social profile (all optional; null = default behaviour).
  coverUrl             String?
  location             String?
  // MEMBERS (default when null) | FOLLOWERS
  profileVisibility    String?
  // EVERYONE (default when null) | FOLLOWING | NOBODY
  dmPolicy             String?

  @@map("vip_profiles")
}

// Admin-managed categories ("spaces") posts are filed under.
model VipSpace {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?   @db.Text
  sortOrder   Int       @default(0)
  // Only admins may start posts here (announcement-style space).
  adminOnly   Boolean   @default(false)
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  posts       VipPost[]

  @@map("vip_spaces")
}

model VipPost {
  id             String           @id @default(cuid())
  authorId       String
  spaceId        String?
  body           String           @db.Text
  imageUrl       String?
  pinned         Boolean          @default(false)
  isAnnouncement Boolean          @default(false)
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   String?
  editedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  space          VipSpace?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  comments       VipComment[]
  reactions      VipReaction[]
  reports        VipReport[]
  // YouTube / Vimeo link shown as a privacy-friendly embed (lib/vip/text videoEmbed).
  videoUrl       String?
  images         VipPostImage[]
  hashtags       VipPostHashtag[]
  bookmarks      VipBookmark[]
  sharedIn       VipMessage[]

  @@index([createdAt])
  @@index([spaceId, createdAt])
  @@index([authorId])
  @@map("vip_posts")
}

// Comments thread ONE level deep: a reply's parentId points at a top-level
// comment, never at another reply (enforced in the API).
model VipComment {
  id         String        @id @default(cuid())
  postId     String
  authorId   String
  parentId   String?
  body       String        @db.Text
  hiddenAt   DateTime?
  hiddenById String?
  editedAt   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  post       VipPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     VipComment?   @relation("VipCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    VipComment[]  @relation("VipCommentReplies")
  reactions  VipReaction[]
  reports    VipReport[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("vip_comments")
}

// A like on a post OR a comment (exactly one of postId/commentId is set).
model VipReaction {
  id        String      @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  kind      String      @default("LIKE")
  createdAt DateTime    @default(now())
  post      VipPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   VipComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, kind])
  @@unique([userId, commentId, kind])
  @@index([postId])
  @@index([commentId])
  @@map("vip_reactions")
}

model VipReport {
  id             String           @id @default(cuid())
  reporterId     String
  postId         String?
  commentId      String?
  reason         String           @db.Text
  // OPEN | RESOLVED | DISMISSED
  status         String           @default("OPEN")
  resolvedById   String?
  resolvedAt     DateTime?
  resolution     String?
  createdAt      DateTime         @default(now())
  reporter       User             @relation("VipReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post           VipPost?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment        VipComment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  // A reported direct message (and its conversation, which admins may then open).
  messageId      String?
  conversationId String?
  message        VipMessage?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation   VipConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([messageId]) // one report per member per message is enforced in the API (a unique here would block db push)
  @@index([conversationId])
  @@map("vip_reports")
}

// In-app only (no email/SMS). type: REPLY | COMMENT | MENTION
model VipNotification {
  id             String    @id @default(cuid())
  userId         String
  type           String
  actorId        String?
  postId         String?
  commentId      String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation("VipNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // MESSAGE notifications: the conversation (one unread notification per conversation).
  conversationId String?

  @@index([userId, readAt, createdAt])
  @@map("vip_notifications")
}

// ─── Classroom ──────────────────────────────────────────────────────────────
// Ships EMPTY. Content is entered by admins in /admin/vip/courses.
model VipCourse {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  summary    String?        @db.Text
  coverImage String?
  // Lowest membership tier that can open this course.
  minTier    MembershipTier @default(CLUB)
  published  Boolean        @default(false)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  modules    VipModule[]

  // Academy (vip/academy): learning path, level, paid trainings. All optional.
  trackId          String?
  track            VipTrack?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  // BEGINNER | INTERMEDIATE | ADVANCED (label only)
  level            String?
  estimatedMinutes Int?
  // true = NOT included in any tier: opens only with a VipCourseGrant
  // (bought with points or money, or granted by an admin).
  purchaseOnly     Boolean?          @default(false)
  // Purchasable price (Zelle invoice through .global) and/or points price.
  // null = not for sale that way.
  priceCents       Int?
  pointsPrice      Int?
  resumes          VipCourseResume[]

  @@index([trackId])
  @@map("vip_courses")
}

model VipModule {
  id        String      @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  course    VipCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   VipLesson[]
  quiz      VipQuiz?

  @@index([courseId, sortOrder])
  @@map("vip_modules")
}

model VipLesson {
  id        String              @id @default(cuid())
  moduleId  String
  title     String
  // Lightweight markdown (headings, bold/italic, links, lists), rendered escaped.
  body      String              @default("") @db.Text
  videoUrl  String?
  // Optional per-lesson override; null = inherit the course minTier.
  minTier   MembershipTier?
  published Boolean             @default(false)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  module    VipModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  VipLessonProgress[]

  // Academy: running time label, downloadable resources, private notes.
  durationMinutes Int?
  resources       VipLessonResource[]
  notes           VipLessonNote[]

  @@index([moduleId, sortOrder])
  @@map("vip_lessons")
}

model VipLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime  @default(now())
  lesson      VipLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("vip_lesson_progress")
}

// ─── Events / live Q&A ──────────────────────────────────────────────────────
model VipEvent {
  id            String         @id @default(cuid())
  title         String
  description   String?        @db.Text
  startsAt      DateTime
  endsAt        DateTime?
  // Join link (video call etc.) — shown to eligible members only.
  joinUrl       String?
  minTier       MembershipTier @default(CLUB)
  published     Boolean        @default(false)
  cancelledAt   DateTime?
  createdById   String?
  // Monthly series: when the latest occurrence starts, the vip-notify cron
  // publishes the next one (same weekday-of-month, same time).
  repeatMonthly Boolean        @default(false)
  seriesId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rsvps         VipEventRsvp[]

  // Events upgrade (vip/academy). All optional.
  // AMA | WORKSHOP | CLASS | OFFICE_HOURS (null = AMA)
  kind             String?
  // Max members marked GOING; the rest join the waitlist. null = unlimited.
  capacity         Int?
  // Recording added after the event; also archived into the Library.
  recordingUrl     String?
  recordingAddedAt DateTime?
  libraryResource  VipResource?

  @@index([startsAt])
  @@index([seriesId, startsAt])
  @@map("vip_events")
}

model VipEventRsvp {
  id            String    @id @default(cuid())
  eventId       String
  userId        String
  // Reminder e-mails already sent (each at most once).
  reminded24hAt DateTime?
  reminded1hAt  DateTime?
  // GOING | WAITLIST (null = GOING, rows from before the waitlist existed).
  status        String?   @default("GOING")
  promotedAt    DateTime?
  createdAt     DateTime  @default(now())
  event         VipEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("vip_event_rsvps")
}

// ─── Rewards (spent at vitalityproject.global checkout) ─────────────────────
// Admin-set monthly store-credit grant per tier. No row / 0 = OFF.
model VipTierReward {
  tier               MembershipTier @id
  monthlyCreditCents Int            @default(0)
  updatedById        String?
  updatedAt          DateTime       @updatedAt

  @@map("vip_tier_rewards")
}

// One row per member per month — the unique key IS the idempotency guard for
// api/cron/vip-member-rewards (a second run for the same period is a no-op).
model VipRewardGrant {
  id               String         @id @default(cuid())
  userId           String
  period           String // "YYYY-MM" (UTC)
  tier             MembershipTier
  amountCents      Int
  storeCreditTxnId String?
  // When the "reward issued" email was handled (sent, or skipped because the
  // member turned reward emails off). Null = still to send.
  noticeAt         DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period])
  @@map("vip_reward_grants")
}

// Single-use guard for the .global → .vip SSO hand-off token (jti).
model VipSsoConsumedToken {
  jti        String   @id
  userId     String
  expiresAt  DateTime
  consumedAt DateTime @default(now())

  @@index([expiresAt])
  @@map("vip_sso_consumed_tokens")
}

// ─── Rewards points economy + partner network (branch vip/rewards) ──────────
// Points live in the shared LoyaltyAccount / LoyaltyTransaction ledger and
// move ONLY through src/lib/vip/points.ts (exactly-once keys, never
// overdraws). These tables hold what points buy (catalog + redemptions), the
// partner businesses in the network, and their monthly statements.
// userId columns here are plain indexed strings (no relation on User): these
// rows are financial history and must outlive an account deletion.

enum VipRewardKind {
  STORE_CREDIT // points → .global store credit (StoreCredit ledger)
  PRODUCT // a .global product/variant, shipped by the team
  MERCH // clubhouse merch (sizes + stock), shipped by the team
  TRAINING // unlocks a classroom course (VipCourseGrant)
  EXPERIENCE // e.g. a 1:1 coaching session, scheduled by the team
}

enum VipRedemptionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  CANCELLED // points returned (REVERSAL) exactly once
}

// One member number per member: printed on the member card / QR and typed or
// scanned at partner businesses. "VP" + 8 digits, the last a Luhn check digit.
model VipMemberCard {
  id           String   @id @default(cuid())
  userId       String   @unique
  memberNumber String   @unique
  createdAt    DateTime @default(now())

  @@map("vip_member_cards")
}

model VipRewardItem {
  id             String            @id @default(cuid())
  slug           String            @unique
  kind           VipRewardKind
  title          String
  description    String            @default("") @db.Text
  imageUrl       String?
  pointsCost     Int
  creditCents    Int? // STORE_CREDIT: credit deposited per redemption
  productId      String? // PRODUCT: the .global product
  variantId      String? // PRODUCT: optional size/variant
  courseId       String? // TRAINING: the classroom course unlocked
  stock          Int? // items without options; null = unlimited
  perMemberLimit Int? // non-cancelled redemptions per member; null = no limit
  minTier        MembershipTier    @default(CLUB)
  active         Boolean           @default(false)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  options        VipRewardOption[]
  redemptions    VipRedemption[]

  @@index([active, sortOrder])
  @@map("vip_reward_items")
}

// Sizes (merch) — each with its own stock.
model VipRewardOption {
  id        String        @id @default(cuid())
  itemId    String
  label     String
  stock     Int? // null = unlimited
  sortOrder Int           @default(0)
  item      VipRewardItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, label])
  @@map("vip_reward_options")
}

model VipRedemption {
  id               String              @id @default(cuid())
  userId           String
  itemId           String
  optionId         String?
  // Snapshots at the moment of redemption.
  kind             VipRewardKind
  title            String
  optionLabel      String?
  pointsSpent      Int
  status           VipRedemptionStatus @default(REQUESTED)
  // "redeem:<userId>:<click key>" — a double click is one redemption.
  idempotencyKey   String              @unique
  spendTxnId       String?             @unique
  refundTxnId      String?             @unique
  storeCreditTxnId String?
  // JSON {name,line1,line2,city,state,zip,country,phone} for shipped kinds.
  shippingAddress  String?             @db.Text
  memberNote       String?             @db.Text
  adminNote        String?             @db.Text
  trackingNumber   String?
  approvedAt       DateTime?
  fulfilledAt      DateTime?
  cancelledAt      DateTime?
  cancelledBy      String? // "member" | "admin"
  handledById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  item             VipRewardItem       @relation(fields: [itemId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([itemId, userId])
  @@map("vip_redemptions")
}

// ─── Academy: learning paths, quizzes, certificates, paid trainings ─────────
// (branch vip/academy). New tables only; columns added to existing vip_*
// tables above are all optional.

// A learning path ("track"): an ordered set of courses.
model VipTrack {
  id        String      @id @default(cuid())
  slug      String      @unique
  title     String
  summary   String?     @db.Text
  // FOUNDATIONS | RESEARCH | HEALTH | FITNESS | LIFESTYLE
  category  String      @default("FOUNDATIONS")
  published Boolean     @default(false)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  courses   VipCourse[]

  @@map("vip_tracks")
}

// Access to one course regardless of tier: bought with points or money, a
// TRAINING reward, or granted by an admin. ONE table shared by rewards and
// academy; classroom access = admin OR tier allows it OR a grant exists
// (lib/vip/classroom.ts — the only place that decides).
model VipCourseGrant {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  // points | purchase | admin | reward
  source    String
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("vip_course_grants")
}

// Shared badge table (rewards, fitness and social award into it).
model VipUserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String
  label     String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId, awardedAt])
  @@map("vip_user_badges")
}

// Member-gets-member: recorded when the referred person starts a membership
// with ?ref=<member number>; points go to the referrer once, when the
// referred person's FIRST membership invoice is paid (mark-paid).
model VipReferral {
  id             String    @id @default(cuid())
  referrerUserId String
  referredUserId String    @unique
  code           String
  awardedAt      DateTime?
  awardTxnId     String?
  createdAt      DateTime  @default(now())

  @@index([referrerUserId])
  @@map("vip_referrals")
}

model VipPartner {
  id                  String                @id @default(cuid())
  slug                String                @unique
  name                String
  logoUrl             String?
  description         String                @default("") @db.Text
  website             String?
  address             String?
  category            String?
  active              Boolean               @default(true)
  // Points a member earns per $1 spent at this partner.
  earnPointsPerDollar Int                   @default(5)
  allowRedemption     Boolean               @default(true)
  // Network fee on member turnover, in basis points (500 = 5%).
  networkFeeBps       Int                   @default(500)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  staff               VipPartnerStaff[]
  txns                VipPartnerTxn[]
  statements          VipPartnerStatement[]

  @@map("vip_partners")
}

// Partner staff: existing users linked to a partner. Additive — no new
// UserRole value; a person may work for more than one partner.
model VipPartnerStaff {
  id        String     @id @default(cuid())
  partnerId String
  userId    String
  role      String     @default("STAFF") // STAFF | MANAGER
  active    Boolean    @default(true)
  addedById String?
  createdAt DateTime   @default(now())
  partner   VipPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@index([userId])
  @@map("vip_partner_staff")
}

enum VipPartnerTxnKind {
  EARN // member purchase recorded at the partner → points awarded
  REDEEM // member points spent at the partner
}

model VipPartnerTxn {
  id              String            @id @default(cuid())
  partnerId       String
  memberUserId    String
  staffUserId     String
  kind            VipPartnerTxnKind
  // EARN: purchase amount. REDEEM: the points' value (100 points = $1).
  amountCents     Int
  points          Int
  // EARN: the partner's receipt number — one award per receipt per partner.
  receiptRef      String?
  ledgerTxnId     String            @unique
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  voidLedgerTxnId String?           @unique
  createdAt       DateTime          @default(now())
  partner         VipPartner        @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, receiptRef])
  @@index([partnerId, createdAt])
  @@index([memberUserId, createdAt])
  @@map("vip_partner_txns")
}

// One-time code a member shows at the counter to approve spending points at
// a partner (staff cannot spend a balance without it). Bound to the partner
// and the amount; 10 minutes; single use; 5 wrong tries burn it.
model VipPartnerRedeemCode {
  id             String    @id @default(cuid())
  userId         String
  partnerId      String
  points         Int
  codeHash       String
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  partnerTxnId   String?
  createdAt      DateTime  @default(now())

  @@index([userId, partnerId, expiresAt])
  @@map("vip_partner_redeem_codes")
}

enum VipStatementStatus {
  DRAFT
  ISSUED
  SETTLED
}

// Monthly settlement per partner. netCents > 0: the partner owes the network;
// < 0: the network owes the partner. Recorded only — paid by Zelle outside
// the app; settlementRef is the Zelle reference.
model VipPartnerStatement {
  id                  String             @id @default(cuid())
  partnerId           String
  period              String // "YYYY-MM" (UTC)
  status              VipStatementStatus @default(DRAFT)
  turnoverCents       Int                @default(0)
  feeBps              Int                @default(0)
  feeCents            Int                @default(0)
  pointsIssued        Int                @default(0)
  pointsIssuedCents   Int                @default(0)
  pointsRedeemed      Int                @default(0)
  pointsRedeemedCents Int                @default(0)
  netCents            Int                @default(0)
  earnCount           Int                @default(0)
  redeemCount         Int                @default(0)
  generatedAt         DateTime           @default(now())
  issuedAt            DateTime?
  settledAt           DateTime?
  settlementRef       String?
  settledById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  partner             VipPartner         @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, period])
  @@index([period])
  @@map("vip_partner_statements")
}

// A file an admin uploaded (lesson PDF, library guide). Stored outside
// public/; served only through /api/vip/files/<id> to members who can open
// the lesson or library item that references it.
model VipFile {
  id              String              @id @default(cuid())
  storageKey      String              @unique
  fileName        String
  mimeType        String
  sizeBytes       Int
  uploadedById    String?
  createdAt       DateTime            @default(now())
  lessonResources VipLessonResource[]
  resources       VipResource[]

  @@map("vip_files")
}

model VipLessonResource {
  id        String    @id @default(cuid())
  lessonId  String
  title     String
  // FILE (fileId) | LINK (url)
  kind      String    @default("FILE")
  url       String?
  fileId    String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  lesson    VipLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file      VipFile?  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([lessonId, sortOrder])
  @@map("vip_lesson_resources")
}

// One quiz per module. Correct answers never leave the server before a
// member submits.
model VipQuiz {
  id        String            @id @default(cuid())
  moduleId  String            @unique
  title     String
  intro     String?           @db.Text
  passPct   Int               @default(70)
  published Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  module    VipModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions VipQuizQuestion[]
  attempts  VipQuizAttempt[]

  @@map("vip_quizzes")
}

model VipQuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  prompt       String   @db.Text
  // string[] (2–6 options)
  options      Json
  correctIndex Int
  explanation  String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  quiz         VipQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, sortOrder])
  @@map("vip_quiz_questions")
}

model VipQuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  correct   Int
  total     Int
  scorePct  Int
  passed    Boolean
  // { [questionId]: chosenIndex }
  answers   Json
  createdAt DateTime @default(now())
  quiz      VipQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@index([userId, createdAt])
  @@map("vip_quiz_attempts")
}

// Completion certificate. Name and course title are snapshots taken at issue
// time; the public verification page (/verify/<code>) shows only the course,
// the date and the code — never the member.
model VipCertificate {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  courseId      String
  recipientName String
  courseTitle   String
  issuedAt      DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@map("vip_certificates")
}

// Private per-lesson notes (only the author ever reads them).
model VipLessonNote {
  id        String    @id @default(cuid())
  userId    String
  lessonId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lesson    VipLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("vip_lesson_notes")
}

// "Resume where you left off": the last lesson a member opened per course.
model VipCourseResume {
  id        String    @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String
  updatedAt DateTime  @updatedAt
  course    VipCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, updatedAt])
  @@map("vip_course_resumes")
}

// Library: guides, PDFs, recordings, explainer links. Tier-gated.
model VipResource {
  id        String         @id @default(cuid())
  title     String
  summary   String?        @db.Text
  // GUIDES | RESEARCH_LITERACY | COA | RECORDINGS | TRAINING | NUTRITION | RECOVERY | LIFESTYLE
  category  String
  // GUIDE | PDF | RECORDING | LINK
  kind      String
  url       String?
  fileId    String?
  minTier   MembershipTier @default(CLUB)
  published Boolean        @default(false)
  // Set when the item is an event recording archived from Events.
  eventId   String?        @unique
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  file      VipFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  event     VipEvent?      @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([published, category])
  @@map("vip_resources")
}

// First-run onboarding answers.
model VipOnboarding {
  id          String    @id @default(cuid())
  userId      String    @unique
  interests   String[]
  goals       String[]
  trackId     String?
  completedAt DateTime?
  skippedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("vip_onboarding")
}

// ─── Social network ─────────────────────────────────────────────────────────

model VipFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("VipFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("VipFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("vip_follows")
}

// Blocks hide both ways: either side loses the other's posts, DMs and profile.
model VipBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("VipBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("VipBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("vip_blocks")
}

// Profile interests / tags (lower-case, max 10 per member).
model VipInterest {
  id     String @id @default(cuid())
  userId String
  tag    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([tag])
  @@map("vip_interests")
}

// Up to 6 images per post (VipPost.imageUrl keeps the first, for older readers).
model VipPostImage {
  id        String  @id @default(cuid())
  postId    String
  url       String
  sortOrder Int     @default(0)
  post      VipPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("vip_post_images")
}

// #hashtags in a post body; createdAt = the post's createdAt (for "trending").
model VipPostHashtag {
  id        String   @id @default(cuid())
  postId    String
  tag       String
  createdAt DateTime @default(now())
  post      VipPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, tag])
  @@index([tag, createdAt])
  @@index([createdAt])
  @@map("vip_post_hashtags")
}

model VipBookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      VipPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@map("vip_bookmarks")
}

// Direct messages: a 1:1 conversation (directKey = "<idA>:<idB>", sorted, so
// there is only ever one per pair) or a small group (up to 20 people).
model VipConversation {
  id            String                       @id @default(cuid())
  isGroup       Boolean                      @default(false)
  title         String?
  directKey     String?                      @unique
  createdById   String
  lastMessageAt DateTime                     @default(now())
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  participants  VipConversationParticipant[]
  messages      VipMessage[]
  reports       VipReport[]

  @@index([lastMessageAt])
  @@map("vip_conversations")
}

model VipConversationParticipant {
  id             String          @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime        @default(now())
  // Left a group: history stays for the others; this member no longer sees it.
  leftAt         DateTime?
  // Read receipt: everything sent up to this moment has been seen.
  lastReadAt     DateTime?
  conversation   VipConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("vip_conversation_participants")
}

model VipMessage {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  body           String          @db.Text
  imageUrl       String?
  // A clubhouse post shared into the conversation.
  sharedPostId   String?
  createdAt      DateTime        @default(now())
  conversation   VipConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  sharedPost     VipPost?        @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)
  reports        VipReport[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("vip_messages")
}
