generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Optional handle. Users pick this on first activation / signup;
  // unique across the platform when set. Login accepts either email
  // or username, falling back to email for legacy accounts that have
  // no username yet.
  username      String?   @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders         Order[]
  addresses      Address[]
  reviews        Review[]
  affiliate      Affiliate?
  sessions       Session[]
  accounts       Account[]
  cartItems      CartItem[]
  orgMemberships OrgMember[]
  orgClients     OrgClient[]
  loyalty        LoyaltyAccount?
  storeCredit    StoreCredit?
  supportTickets SupportTicket[]
  membership     Membership?
  refundsCreated Refund[]        @relation("RefundCreatedBy")
  wishlistItems  WishlistItem[]

  // VIP clubhouse (vitalityproject.vip) — relation fields only, no columns.
  vipProfile        VipProfile?
  vipPosts          VipPost[]
  vipComments       VipComment[]
  vipReports        VipReport[]         @relation("VipReportReporter")
  vipNotifications  VipNotification[]   @relation("VipNotificationRecipient")
  vipRewardGrants   VipRewardGrant[]
  vipReactions      VipReaction[]
  vipLessonProgress VipLessonProgress[]
  vipEventRsvps     VipEventRsvp[]

  verifyToken       String?                      @unique
  resetToken        String?                      @unique
  resetTokenExpiry  DateTime?
  twoFASecret       String?
  twoFAEnabled      Boolean                      @default(false)
  birthday          DateTime?
  // VIP social network (follow graph, DMs, bookmarks, badges) — relations only.
  vipFollowing      VipFollow[]                  @relation("VipFollowFollower")
  vipFollowers      VipFollow[]                  @relation("VipFollowFollowing")
  vipBlocksMade     VipBlock[]                   @relation("VipBlockBlocker")
  vipBlocksReceived VipBlock[]                   @relation("VipBlockBlocked")
  vipBadges         VipUserBadge[]
  vipInterests      VipInterest[]
  vipBookmarks      VipBookmark[]
  vipConversations  VipConversationParticipant[]
  vipMessages       VipMessage[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  AFFILIATE
  ADMIN
}

// ─── Organizations & Tenancy ────────────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  type      OrgType
  status    OrgStatus @default(ACTIVE)
  // 4-6 digit PIN that protects the "Exit kiosk" button on this org's
  // iPad displays. Null = exit is unprotected (default for orgs that
  // haven't set one). Stored as plaintext intentionally — it's a curious-
  // customer guard, not a security boundary; the real auth lives at
  // /admin via NextAuth.
  kioskPin  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  locations    Location[]
  members      OrgMember[]
  clients      OrgClient[]
  pricingPlans PricingPlan[]
  orders       Order[]

  @@map("organizations")
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zip            String?
  phone          String?
  commissionRate Float   @default(0.10)
  pricingPlanId  String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pricingPlan  PricingPlan?      @relation(fields: [pricingPlanId], references: [id])
  devices      LocationDevice[]
  orders       Order[]
  clients      OrgClient[]
  members      OrgMember[]
  commissions  OrderCommission[]

  @@unique([organizationId, slug])
  @@map("locations")
}

model OrgMember {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  role           OrgMemberRole
  locationId     String?

  // Personal trainer/coach referral code — used by /join?t=<code> to attribute
  // new customer signups to this trainer. Optional because OWNER/ADMIN don't
  // typically need one; auto-generated for STAFF/COACH/DOCTOR on creation.
  referralCode String? @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])

  attributedClients OrgClient[] @relation("TrainerAttributedClients")

  @@unique([organizationId, userId])
  @@index([referralCode])
  @@map("org_members")
}

model OrgClient {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  locationId     String?
  status         ClientStatus @default(ACTIVE)

  // Trainer / coach attribution — which OrgMember "owns" this client.
  // Lifetime — set on first attribution and survives unless admin reassigns.
  trainerOrgMemberId String?
  trainer            OrgMember? @relation("TrainerAttributedClients", fields: [trainerOrgMemberId], references: [id], onDelete: SetNull)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])
  orders       Order[]

  @@unique([organizationId, userId])
  @@index([trainerOrgMemberId])
  @@map("org_clients")
}

model LocationDevice {
  id         String    @id @default(cuid())
  locationId String
  name       String
  apiKey     String    @unique
  lastSeenAt DateTime?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("location_devices")
}

model PricingPlan {
  id              String @id @default(cuid())
  organizationId  String
  name            String
  baseDiscountPct Float?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  overrides    ProductPriceOverride[]
  locations    Location[]

  @@unique([organizationId, name])
  @@map("pricing_plans")
}

model ProductPriceOverride {
  id            String @id @default(cuid())
  pricingPlanId String
  productId     String
  price         Int

  pricingPlan PricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pricingPlanId, productId])
  @@map("product_price_overrides")
}

model OrderCommission {
  id         String           @id @default(cuid())
  orderId    String
  locationId String
  amount     Int
  status     CommissionStatus @default(PENDING)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orderId, locationId])
  @@map("order_commissions")
}

enum OrgType {
  GYM
  CLINIC
  DOCTOR_OFFICE
  OTHER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OrgMemberRole {
  OWNER
  ADMIN
  STAFF
  COACH
  DOCTOR
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())

  @@map("categories")
}

model Product {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  description    String                 @db.Text
  shortDesc      String?
  price          Int // in cents
  comparePrice   Int? // original/strikethrough price
  salePrice      Int? // overrides price when set (sale event)
  cost           Int? // cost of goods
  sku            String?                @unique
  barcode        String?
  categoryId     String?
  category       Category?              @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  inventory      Int                    @default(0)
  trackInventory Boolean                @default(false)
  weight         Float? // in grams
  status         ProductStatus          @default(DRAFT)
  featured       Boolean                @default(false)
  seoTitle       String?
  seoDesc        String?
  tags           String[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  reviews        Review[]
  priceOverrides ProductPriceOverride[]
  facilities     ProductFacility[]
  wishlistedBy   WishlistItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String // e.g. "10mg / 30 vials"
  sku       String?
  price     Int // in cents
  inventory Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String? // for guest carts
  productId String
  variantId String?
  quantity  Int      @default(1)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  email             String
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  paymentMethod     String? // stripe | crypto
  paymentId         String? // stripe payment intent or crypto charge id
  subtotal          Int // in cents
  discount          Int           @default(0)
  shipping          Int           @default(0)
  tax               Int           @default(0)
  total             Int // in cents
  discountCode      String?
  notes             String?
  items             OrderItem[]
  shippingAddress   Address?      @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String?
  trackingNumber    String?
  trackingUrl       String?
  affiliateCode     String?
  affiliateId       String?
  organizationId    String?
  locationId        String?
  clientId          String?
  salesChannel      OrderChannel  @default(DIRECT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization        Organization?     @relation(fields: [organizationId], references: [id])
  location            Location?         @relation(fields: [locationId], references: [id])
  client              OrgClient?        @relation(fields: [clientId], references: [id])
  commissions         OrderCommission[]
  fulfillments        Fulfillment[]
  refunds             Refund[]
  storeCreditUsed     Int               @default(0)
  loyaltyPointsUsed   Int               @default(0)
  loyaltyPointsEarned Int               @default(0)

  @@index([organizationId])
  @@index([locationId])
  @@index([clientId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum OrderChannel {
  DIRECT
  LOCATION_KIOSK
  CLIENT_PORTAL
  ADMIN
}

model OrderItem {
  id               String            @id @default(cuid())
  orderId          String
  productId        String
  variantId        String?
  name             String // snapshot at time of purchase
  sku              String?
  price            Int // in cents, snapshot
  quantity         Int
  total            Int // in cents
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  fulfillmentItems FulfillmentItem[]

  @@map("order_items")
}

// ─── Refunds ─────────────────────────────────────────────────────────────────
// First-class refund record. Created by admin from /admin/orders/[id]. Cash
// refunds (Chase / Stripe) and store-credit refunds both write a row here so
// the P&L on /admin can sum a single source of truth instead of inferring
// from StoreCreditTxn for credit-only refunds.
model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int // in cents — always positive
  method      RefundMethod @default(STORE_CREDIT)
  reason      String?      @db.Text
  // External processor reference (Chase orbital ID / Stripe refund ID / store
  // credit txn id). Null until the actual refund is initiated.
  externalRef String?
  status      RefundStatus @default(PENDING)
  // Admin who initiated. Null when triggered by an automated webhook flow.
  createdById String?
  createdBy   User?        @relation("RefundCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([orderId])
  @@index([createdAt])
  @@map("refunds")
}

enum RefundMethod {
  CASH // back to original payment method (card)
  STORE_CREDIT // issued as store credit
  MANUAL // recorded out-of-band (check, ACH, etc.)
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

// ─── Addresses ───────────────────────────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String  @default("US")
  phone     String?
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@map("addresses")
}

// ─── Discount Codes ──────────────────────────────────────────────────────────

model DiscountCode {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType @default(PERCENTAGE)
  value     Int // percentage (1-100) or cents
  minOrder  Int? // minimum order in cents
  maxUses   Int?
  usedCount Int          @default(0)
  active    Boolean      @default(true)
  expiresAt DateTime?
  rule      CouponRule?
  createdAt DateTime     @default(now())

  @@map("discount_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BOGO
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  title     String?
  body      String?  @db.Text
  approved  Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}

// ─── Affiliate System (Package C) ────────────────────────────────────────────

model Affiliate {
  id             String                @id @default(cuid())
  userId         String                @unique
  code           String                @unique
  commissionRate Float                 @default(0.10) // 10%
  status         AffiliateStatus       @default(PENDING)
  paypalEmail    String?
  bankInfo       String?               @db.Text // encrypted
  totalEarned    Int                   @default(0) // in cents
  totalPaid      Int                   @default(0) // in cents
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks         AffiliateClick[]
  commissions    AffiliateCommission[]
  links          AffiliateLink[]
  payouts        AffiliatePayout[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("affiliates")
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model AffiliateLink {
  id          String    @id @default(cuid())
  affiliateId String
  name        String
  slug        String    @unique
  url         String // destination URL
  active      Boolean   @default(true)
  clicks      Int       @default(0)
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("affiliate_links")
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  ip          String
  userAgent   String?
  referrer    String?
  sessionId   String
  converted   Boolean   @default(false)
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("affiliate_clicks")
}

model AffiliateCommission {
  id          String           @id @default(cuid())
  affiliateId String
  orderId     String
  amount      Int // in cents
  status      CommissionStatus @default(PENDING)
  affiliate   Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@map("affiliate_commissions")
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model AffiliatePayout {
  id          String    @id @default(cuid())
  affiliateId String
  amount      Int // in cents
  method      String // paypal | wire
  reference   String?
  notes       String?
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("affiliate_payouts")
}

// ─── AI Chat (Package D) ─────────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  sessionId String        @unique
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String // user | assistant
  content   String      @db.Text
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@map("chat_messages")
}

// ─── Shipping Rules ───────────────────────────────────────────────────────────

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  countries String[]
  rates     ShippingRate[]
  active    Boolean        @default(true)

  @@map("shipping_zones")
}

model ShippingRate {
  id            String       @id @default(cuid())
  zoneId        String
  name          String // e.g. "Standard", "Express"
  price         Int // in cents
  minWeight     Float?
  maxWeight     Float?
  minOrderValue Int? // free shipping threshold
  zone          ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}

// ─── Site Settings ────────────────────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Membership Pre-Signups ──────────────────────────────────────────────────

model MembershipSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  plan      String   @default("monthly") // monthly, quarterly, annual
  source    String? // where they signed up from (hero, product, nav, etc)
  createdAt DateTime @default(now())

  @@map("membership_signups")
}

// ─── Fulfillment Facilities (licensed Florida labs) ──────────────────────────

model Facility {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  contactName   String?
  email         String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String            @default("FL")
  zip           String
  country       String            @default("US")
  licenseNumber String?
  apiEndpoint   String? // supplier API base URL
  apiKey        String? // encrypted credentials
  active        Boolean           @default(true)
  slaHours      Int               @default(48) // fulfillment SLA
  notes         String?           @db.Text
  products      ProductFacility[]
  fulfillments  Fulfillment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("facilities")
}

model ProductFacility {
  id         String   @id @default(cuid())
  productId  String
  facilityId String
  primary    Boolean  @default(false) // default facility for this product
  cost       Int? // wholesale cost in cents
  inventory  Int      @default(0) // facility-tracked inventory
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([productId, facilityId])
  @@map("product_facilities")
}

model Fulfillment {
  id             String            @id @default(cuid())
  orderId        String
  facilityId     String
  status         FulfillmentStatus @default(PENDING)
  externalId     String? // supplier's order reference
  trackingNumber String?
  trackingUrl    String?
  carrier        String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?           @db.Text
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  facility       Facility          @relation(fields: [facilityId], references: [id])
  items          FulfillmentItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([orderId])
  @@index([facilityId])
  @@index([status])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String      @id @default(cuid())
  fulfillmentId String
  orderItemId   String
  quantity      Int
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id])

  @@map("fulfillment_items")
}

enum FulfillmentStatus {
  PENDING
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

// ─── Loyalty & Rewards ──────────────────────────────────────────────────────

model LoyaltyAccount {
  id            String               @id @default(cuid())
  userId        String               @unique
  tier          LoyaltyTier          @default(BRONZE)
  points        Int                  @default(0)
  lifetimeSpend Int                  @default(0) // cents
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  LoyaltyTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("loyalty_accounts")
}

enum LoyaltyTier {
  BRONZE // default
  SILVER // $500+ lifetime
  GOLD // $2000+ lifetime
  PLATINUM // $5000+ lifetime
}

model LoyaltyTransaction {
  id             String         @id @default(cuid())
  accountId      String
  type           LoyaltyTxType
  points         Int // positive for earn, negative for redeem
  description    String
  orderId        String? // if tied to an order
  // Exactly-once key for engagement/partner/reward awards (e.g.
  // "lesson:<id>:<userId>"). A second award with the same key is a no-op.
  idempotencyKey String?        @unique
  // Where the points came from or went: "vip", "global", "partner:<slug>".
  source         String?
  account        LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

enum LoyaltyTxType {
  EARN_PURCHASE
  EARN_REFERRAL
  EARN_REVIEW
  EARN_BIRTHDAY
