  REDEEM_DISCOUNT
  EXPIRE
  ADJUST // admin adjustment
  EARN_ENGAGEMENT // clubhouse activity: lessons, posts, events, streaks, workouts, challenges
  EARN_PARTNER // spend at a partner business in the rewards network
  REDEEM_REWARD // spent in the clubhouse rewards catalog (product, merch, training)
